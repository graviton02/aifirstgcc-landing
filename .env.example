# Convex deployment (auto-set by `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Next.js public variables
NEXT_PUBLIC_CONVEX_URL=your_convex_deployment_url
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
# Clerk issuer used by `convex/auth.config.ts`
# Example: https://your-tenant.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-issuer
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

# Server-side Convex env vars (set via `npx convex env set`)
# ADMIN_CLERK_USER_IDS=user_123,user_456
# ADMIN_CLERK_EMAILS=admin@yourcompany.com,ops@yourcompany.com
# ADMIN_NOTIFICATION_EMAIL=admin@example.com
# RESEND_API_KEY=your_resend_api_key
# OPENAI_API_KEY=your_openai_api_key
# CLERK_SECRET_KEY=your_clerk_secret_key
# CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret

# Build / release observability
# SENTRY_AUTH_TOKEN=your_sentry_auth_token
# SENTRY_ORG=your_sentry_org_slug
# SENTRY_PROJECT=your_sentry_project_slug
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=your_release_identifier
